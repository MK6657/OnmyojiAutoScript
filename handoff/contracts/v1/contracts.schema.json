{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/automation-evidence/v1/contracts.schema.json",
  "title": "Automation Evidence Contracts v1",
  "$defs": {
    "DeviceIdentity": {
      "type": "object",
      "required": ["contract_version", "identity_id", "source", "stability", "claims"],
      "properties": {
        "contract_version": {"const": 1},
        "identity_id": {"type": "string", "minLength": 1},
        "source": {"enum": ["nemu_ipc", "adb", "windows", "import"]},
        "stability": {"enum": ["stable", "session", "unverified"]},
        "serial": {"type": ["string", "null"]},
        "serial_aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "instance_id": {"type": ["string", "integer", "null"]},
        "display_id": {"type": ["string", "integer", "null"]},
        "hwnd": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "window_title": {"type": ["string", "null"]},
        "pid": {"type": ["integer", "null"], "minimum": 0},
        "package_name": {"type": ["string", "null"]},
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "value", "verified_at"],
            "properties": {
              "kind": {"type": "string"},
              "value": {},
              "verified_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "FrameEnvelope": {
      "type": "object",
      "required": ["contract_version", "frame_id", "captured_at", "device", "source", "width", "height", "orientation", "pixel_format", "sha256", "canvas_profile", "mapping_revision", "artifact_ref"],
      "properties": {
        "contract_version": {"const": 1},
        "frame_id": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "device": {"$ref": "#/$defs/DeviceIdentity"},
        "source": {"enum": ["nemu_ipc", "adb", "screen", "import"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "orientation": {"enum": [0, 90, 180, 270]},
        "pixel_format": {"const": "RGB"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canvas_profile": {"type": "string", "minLength": 1},
        "mapping_revision": {"type": "integer", "minimum": 0},
        "artifact_ref": {"type": "string", "pattern": "^artifact://"}
      },
      "additionalProperties": true
    },
    "CandidateEnvelope": {
      "type": "object",
      "required": ["contract_version", "candidate_id", "semantic", "geometry", "coordinate_space", "canvas_profile", "mapping_revision", "source_frame_id", "source_frame_sha256", "confidence", "warnings", "apply_state"],
      "properties": {
        "contract_version": {"const": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "semantic": {"type": "string", "minLength": 1},
        "geometry": {
          "type": "object",
          "required": ["shape_type", "shape"],
          "properties": {
            "shape_type": {"enum": ["point", "rect", "circle", "ellipse", "polygon"]},
            "shape": {"type": "object"}
          },
          "additionalProperties": false
        },
        "coordinate_space": {"const": "canvas"},
        "canvas_profile": {"type": "string", "minLength": 1},
        "mapping_revision": {"type": "integer", "minimum": 0},
        "source_frame_id": {"type": "string", "minLength": 1},
        "source_frame_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "apply_state": {"const": "candidate_only"}
      },
      "additionalProperties": false
    },
    "EvidenceManifest": {
      "type": "object",
      "required": ["contract_version", "manifest_id", "scope", "created_at", "artifacts", "observations", "test_runs", "claims"],
      "properties": {
        "contract_version": {"const": 1},
        "manifest_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact_ref", "sha256", "media_type"],
            "properties": {
              "artifact_ref": {"type": "string", "pattern": "^artifact://"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "media_type": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "observations": {"type": "array", "items": {"type": "object"}},
        "test_runs": {"type": "array", "items": {"type": "object"}},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "status", "evidence_refs"],
            "properties": {
              "claim": {"type": "string"},
              "status": {"enum": ["confirmed", "rejected", "inconclusive", "pending"]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "BattlePreparationResult": {
      "type": "object",
      "required": ["contract_version", "status", "frame_id", "frame_sha256", "auto_mode", "preset", "soul", "green_mark", "reasons"],
      "properties": {
        "contract_version": {"const": 1},
        "status": {"enum": ["prepared", "degraded", "blocked", "terminal"]},
        "frame_id": {"type": "string"},
        "frame_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "auto_mode": {"enum": ["confirmed", "unconfirmed", "not_applicable"]},
        "preset": {"enum": ["confirmed", "unconfirmed", "skipped"]},
        "soul": {"enum": ["confirmed", "unconfirmed", "skipped"]},
        "green_mark": {
          "type": "object",
          "required": ["status", "target", "attempts", "reason"],
          "properties": {
            "status": {"enum": ["confirmed", "unconfirmed", "skipped", "terminal"]},
            "target": {"type": ["string", "null"]},
            "click_point": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
            "marker_point": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
            "detector": {"type": ["string", "null"]},
            "max_score": {"type": ["number", "null"]},
            "attempts": {"type": "integer", "minimum": 0},
            "reason": {"type": "string"}
          },
          "additionalProperties": true
        },
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}

